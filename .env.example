# CarbonCore Environment Variables
# Copy this file to .env and fill in real values for local development.
# Set these same variable names in your Railway project environment.

# Supabase PostgreSQL connection string
# Format: postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres
DATABASE_URL=

# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional: restrict CORS in production (comma-separated origins)
# Leave blank or omit to allow all origins (fine when same-origin on Railway)
# ALLOWED_ORIGINS=https://yourapp.railway.app
